# Variables de entorno del pago por transferencia (SPEC 12). Todas son solo de
# servidor: nunca con prefijo NEXT_PUBLIC_. Copiá lo que falte a .env.local.

# --- Supabase (service role: webhook, cron y pantallas de /admin/pagos) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Cuenta de Mercado Pago dedicada al prode ---
# Access token de la aplicación creada en el panel de desarrolladores de MP.
MP_ACCESS_TOKEN=
# Clave secreta del webhook (panel de MP > Webhooks), para validar x-signature.
MP_WEBHOOK_SECRET=
# Opcional: id de usuario de la cuenta cobradora. Permite distinguir egresos.
MP_USER_ID=

# --- Datos que ve el usuario para transferir ---
PAGO_ALIAS=
PAGO_CBU=
PAGO_TITULAR=
# "false" relaja la regla del remitente si MP no informa quién transfirió
# (ver el spike de SPEC 12). Por defecto se exige.
# PAGO_EXIGIR_REMITENTE=true

# --- Lectura de comprobantes con IA (Gemini) ---
GEMINI_API_KEY=
# Opcional. Por defecto gemini-flash-latest. Para más precisión: gemini-pro-latest.
# GEMINI_MODEL=gemini-flash-latest

# --- Cron de conciliación (GET /api/cron/conciliar) ---
# El cron debe enviar: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
